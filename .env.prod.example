# Inject these variables through the deployment environment. Never commit secrets.
SPRING_PROFILES_ACTIVE=prod
PROD_DB_URL=jdbc:mysql://your-production-host:3306/parttime_hiring_platform_prod
PROD_DB_USERNAME=replace-with-production-db-user
PROD_DB_PASSWORD=replace-with-production-db-password
FRONTEND_URL=https://your-frontend-domain
CORS_ALLOWED_ORIGINS=https://your-frontend-domain
JWT_SIGNER_KEY=replace-with-a-long-random-production-signing-key
JWT_SECRET=replace-with-production-secret
MAIL_USERNAME=replace-with-mail-account
MAIL_PASSWORD=replace-with-mail-password
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret
